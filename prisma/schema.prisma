// =============================================================================
// RAHAYU FASHION STORE — SCALABLE POSTGRESQL SCHEMA (PHASE 1 FOUNDATION v4.0)
// Supports:
// - Customer Authentication (Login/OTP/Google OAuth), Customer Profile & Address Book
// - Tokopedia-style Transaction History & Live Shipment Tracking inside Customer Profile
// - 11 Official Fashion Categories with Dynamic Size & Variant Templates
// - Short Product Videos (Cloudflare R2 MP4 + External TikTok/Reels Link)
// - TikTok Live Stream Banner & Pinned Live Products
// - Promo Badges, Promo Highlight Campaigns & Voucher Rules
// - Admin Payment Method Control Panel (Gateway & Manual Transfer Channels)
// - Built-in SEO Manager, Schema.org JSON-LD & Official Social Media Links
// - AI Product Photo Studio Jobs
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  MENUNGGU_BAYAR
  DIKEMAS
  DIKIRIM
  SELESAI
  DIBATALKAN
}

enum MediaType {
  IMAGE
  SHORT_VIDEO_MP4
  EXTERNAL_VIDEO_LINK
}

enum AiPipelineMode {
  STUDIO_BACKGROUND_RELIGHT
  VIRTUAL_TRY_ON_HIJAB
  VIRTUAL_TRY_ON_CASUAL
  VIRTUAL_TRY_ON_KIDS
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  whatsappNumber      String?           @unique
  passwordHash        String?
  googleId            String?           @unique
  fullName            String
  avatarUrl           String?
  role                UserRole          @default(CUSTOMER)
  loyaltyPoints       Int               @default(0)
  preferredSizeNote   String?           // e.g., "Atasan: M, Hijab: 115x115 cm"
  addresses           CustomerAddress[]
  orders              Order[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model CustomerAddress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String   // e.g., "Rumah", "Kantor"
  recipientName   String
  recipientPhone  String
  fullAddress     String   @db.Text
  city            String
  postalCode      String
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Category {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  nameId                String    // e.g., "Atasan Muslim Wanita", "Celana Panjang & Legging"
  nameEn                String
  navGroup              String    // "MODEST_WEAR" | "CONTEMPORARY" | "MATERNITY_ESSENTIALS" | "KIDS_BABY"
  sizePresets           String[]  // Dynamic sizes managed in Admin Control Panel
  measurementLabel      String    @default("Ukuran Standar")
  variantAttributeLabel String    @default("Warna & Bahan")
  colorPresetsJson      Json?     // Array of { name: string, hex: string }
  seoTitle              String?
  seoDescription        String?   @db.Text
  sortOrder             Int       @default(0)
  isActive              Boolean   @default(true)
  products              Product[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Product {
  id                String            @id @default(cuid())
  sku               String            @unique
  slug              String            @unique
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  nameId            String
  descriptionId     String            @db.Text
  basePriceIdr      Int
  compareAtPriceIdr Int?
  promoBadgeText    String?
  isPromoHighlight  Boolean           @default(false)
  shortVideoUrl     String?
  externalVideoUrl  String?
  isFeaturedInLive  Boolean           @default(false)
  weightGrams       Int               @default(350)
  seoMetaTitle      String?
  seoMetaDesc       String?           @db.Text
  isActive          Boolean           @default(true)
  variants          ProductVariant[]
  media             ProductMedia[]
  aiGenerationLogs  AiGenerationLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([categoryId, isActive])
  @@index([isPromoHighlight])
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantSku    String  @unique
  sizeLabel     String
  colorName     String
  colorHex      String?
  customAttrVal String?
  stockQty      Int     @default(0)
  priceDiff     Int     @default(0)
}

model ProductMedia {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MediaType @default(IMAGE)
  url           String
  isAiGenerated Boolean   @default(false)
  sortOrder     Int       @default(0)
}

model PaymentMethodConfig {
  id            String   @id @default(cuid())
  code          String   @unique
  displayName   String
  channelType   String
  providerName  String   @default("MIDTRANS")
  instructions  String   @db.Text
  accountNumber String?
  accountHolder String?
  adminFeeIdr   Int      @default(0)
  isEnabled     Boolean  @default(true)
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique // e.g., "INV/20261113/RHY/9045"
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  customerName     String
  customerWhatsapp String
  shippingAddress  String      @db.Text
  courierName      String
  trackingNumber   String?
  subtotalIdr      Int
  discountIdr      Int         @default(0)
  shippingCostIdr  Int
  totalAmountIdr   Int
  paymentMethod    String
  status           OrderStatus @default(MENUNGGU_BAYAR)
  itemsJson        Json
  trackingLogsJson Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model PromoCampaign {
  id              String   @id @default(cuid())
  title           String
  voucherCode     String?  @unique
  badgeLabel      String
  badgeColorHex   String   @default("#E11D48")
  discountPercent Int
  maxDiscountIdr  Int?
  isHighlighted   Boolean  @default(true)
  bannerImageUrl  String?
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model SiteSeoAndSocialConfig {
  id               String   @id @default("default")
  siteMetaTitle    String   @default("Rahayu Fashion Store — Koleksi Hijab, Busana Muslim Wanita, Baju Hamil & Anak Resmi")
  siteMetaDesc     String   @db.Text
  footerSeoHeading String
  footerSeoArticle String   @db.Text
  tiktokUrl        String   @default("https://www.tiktok.com/@rahayufashion.store")
  instagramUrl     String   @default("https://www.instagram.com/rahayufashion.id")
  youtubeUrl       String   @default("https://www.youtube.com/@rahayufashion")
  facebookUrl      String   @default("https://www.facebook.com/rahayufashionstore")
  pinterestUrl     String?
  whatsappCsUrl    String   @default("https://wa.me/6281288997744")
  updatedAt        DateTime @updatedAt
}

model LiveStreamConfig {
  id              String    @id @default(cuid())
  platform        String    @default("TIKTOK")
  accountHandle   String    @default("@rahayufashion.store")
  liveTitle       String
  liveStreamUrl   String
  pinnedVoucher   String?
  isLiveNow       Boolean   @default(false)
  viewerCountEst  Int       @default(0)
  scheduledNextAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model AiGenerationLog {
  id               String         @id @default(cuid())
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id])
  pipelineMode     AiPipelineMode
  rawInputImageUrl String
  outputImageUrl   String?
  promptUsed       String         @db.Text
  providerName     String         @default("fal.ai")
  estimatedCostIdr Int            @default(600)
  status           AiJobStatus    @default(QUEUED)
  createdAt        DateTime       @default(now())
}
