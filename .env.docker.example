# ==============================================================================
# RAHAYU FASHION STORE — DOCKER ENVIRONMENT TEMPLATE (.env)
# ==============================================================================

# PostgreSQL Container Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rahayu_secure_password_2026
POSTGRES_DB=rahayu_fashion
POSTGRES_PORT=5432

# Application Configuration
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dual-Build & Demo Connector Configuration
# Set to 'false' in production to strip all admin links from the customer webfront DOM
NEXT_PUBLIC_SHOW_DEMO_CONNECTOR=true
ADMIN_PORT=3001
ADMIN_SITE_URL=http://localhost:3001

# Midtrans / Payment Gateway Keys (Test/Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx

# Cloudflare R2 Media Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=rahayu-fashion-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.rahayufashion.co.id

# AI Photoshoot & Copywriting API
FAL_KEY=your_fal_ai_api_key
