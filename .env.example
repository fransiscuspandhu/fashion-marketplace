# ----------------------------------------
# Rahayu Fashion Store — Environment Variables
# ----------------------------------------

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rahayu_fashion?schema=public"

# Next.js Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Midtrans / Payment Gateway Keys (Test/Sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"

# Cloudflare R2 Storage (Zero Egress Bandwidth)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="rahayu-fashion-media"
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.rahayufashion.co.id"

# AI Product Photo Generation API (fal.ai / Replicate)
FAL_KEY="your_fal_ai_api_key"

# WhatsApp Notification Gateway (Fonnte / Wablas)
WA_GATEWAY_TOKEN="your_whatsapp_token"
WA_GATEWAY_SENDER="081288776655"
