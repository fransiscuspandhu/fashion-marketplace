# =============================================================================
# RAHAYU FASHION STORE — ENVIRONMENT VARIABLES TEMPLATE (PHASE 4 PRODUCTION)
# =============================================================================

# 1. DATABASE CONNECTION (PostgreSQL & Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="rahayu_fashion"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rahayu_fashion?schema=public"

# 2. SITE URL & ENVIRONMENT
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
NEXT_PUBLIC_SHOW_DEMO_CONNECTOR="true"

# 3. PAYMENT GATEWAY: MIDTRANS SNAP (QRIS & VIRTUAL ACCOUNT OTOMATIS)
# Dapatkan di: https://dashboard.midtrans.com/ -> Settings -> Access Keys
# -----------------------------------------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-your_server_key_here"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your_client_key_here"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your_client_key_here"
MIDTRANS_IS_PRODUCTION="false" # Ubah "true" saat beralih ke production

# 4. PAYMENT GATEWAY: XENDIT (ALTERNATIF)
# Dapatkan di: https://dashboard.xendit.co/ -> Settings -> API Keys
# -----------------------------------------------------------------------------
XENDIT_SECRET_KEY="xnd_development_your_xendit_secret_key"
XENDIT_PUBLIC_KEY="xnd_public_your_xendit_public_key"

# 5. ALL-IN-ONE AI PIPELINE: GOOGLE GEMINI & NANO BANANA (PHOTOSHOOT + STYLIST + COPYWRITER)
# Dapatkan GRATIS di: https://aistudio.google.com/app/apikey
# CUKUP 1 KUNCI INI untuk mengaktifkan:
# - AI Photoshoot Studio (Google Nano Banana Gemini 2.5/3.1 Image Generation)
# - AI Virtual Stylist Chatbot (Gemini 2.5 Flash)
# - AI SEO Product Copywriter
# -----------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGoogleGeminiApiKeyHere"

# 6. ALTERNATIVE AI PIPELINES (OPSIONAL / CADANGAN)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"
FAL_KEY="your_fal_ai_key_here"
REPLICATE_API_TOKEN="r8_your_replicate_api_token_here"

# 8. TIKTOK LIVE BROADCAST CONNECTOR
# -----------------------------------------------------------------------------
TIKTOK_USERNAME="rahayufashion.store"
TIKTOK_SESSION_ID="" # Opsional jika menggunakan autentikasi session

# 9. CLOUDFLARE R2 OBJECT STORAGE (FOTO KATALOG & VIDEO PDP 9:16 - RP 0 EGRESS)
# Dapatkan di: Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="rahayu-fashion-media"
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.rahayufashion.co.id"

# 10. WHATSAPP NOTIFICATION GATEWAY (FONNTE / WABLAS)
# -----------------------------------------------------------------------------
WA_GATEWAY_TOKEN="your_fonnte_or_wablas_token"
WA_GATEWAY_SENDER="081288997744"
